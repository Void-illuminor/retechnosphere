# reTechnoSphere environment.
# - BACKEND (Railway): set the server vars below.
# - FRONTEND (Render static site): set VITE_API_BASE only (it's a build-time var).
# Copy to .env for local dev (combined mode needs none of these).

# === FRONTEND build (Render static site) ==================================
# URL of the backend API. Leave empty for combined single-host deployments.
VITE_API_BASE=https://your-backend.up.railway.app

# === BACKEND (Railway) ====================================================
# --- Email (Resend) ---
# Get a key at https://resend.com. WITHOUT it, emails are logged ("dry-run").
RESEND_API_KEY=
# Sender address. For real delivery, verify a domain in Resend and use it.
# onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM="reTechnoSphere <onboarding@resend.dev>"

# --- URLs (used in emails) ---
# Player-facing app (the Render frontend) — used for "Visit the Sphere" links.
PUBLIC_URL=https://your-frontend.onrender.com
# This backend's own URL (Railway) — used for the unsubscribe link.
API_PUBLIC_URL=https://your-backend.up.railway.app

# --- CORS ---
# Lock the API to your frontend origin (recommended), or "*" for any.
CORS_ORIGIN=https://your-frontend.onrender.com

# --- Persistence & simulation ---
DATA_DIR=/data            # mount a Railway volume here
SIM_SPEED=1               # world speed vs real time
# WORLD_SEED=12345         # fixed seed (optional)
CATCHUP_CAP_SECONDS=7200  # max sim-time to fast-forward after downtime

# --- Secrets ---
ADMIN_SECRET=             # protects /api/admin/* (reset, force digest)
CRON_SECRET=              # protects /api/cron (optional external scheduler)

# PORT is injected by Railway automatically; defaults to 8787 locally.
