# Copy to .env for local dev (or set these in your host's dashboard).

# --- Email (Resend) -------------------------------------------------------
# Get a key at https://resend.com. WITHOUT this, emails are not sent — they are
# logged to the console ("dry-run"), so you can develop the whole flow offline.
RESEND_API_KEY=
# The "from" address. For real delivery, verify a domain in Resend and use it
# (e.g. "reTechnoSphere <noreply@yourdomain.com>"). The onboarding@resend.dev
# sender only delivers to your own Resend account email.
EMAIL_FROM="reTechnoSphere <onboarding@resend.dev>"

# --- Deployment -----------------------------------------------------------
# Public URL of your deployment; used for links inside emails.
PUBLIC_URL=http://localhost:8787
# Where the world snapshot, subscribers and events are stored. In production,
# point this at a persistent disk/volume.
DATA_DIR=./data
# Port the server listens on.
PORT=8787

# --- Simulation -----------------------------------------------------------
# World speed vs real time (1 = real-time evolution). Higher = faster evolution.
SIM_SPEED=1
# Optional fixed seed so the world is reproducible; omit for a random one.
# WORLD_SEED=12345
# Max sim-seconds to fast-forward after downtime (keeps restarts quick).
CATCHUP_CAP_SECONDS=3600

# --- Secrets --------------------------------------------------------------
# Allow admin actions (reset world) and an external scheduler to trigger digests.
ADMIN_SECRET=
CRON_SECRET=
